# Auto detect text files and perform LF normalization
* text=auto
# Source code
*.py text eol=lf linguist-language=Python
*.kt text eol=lf linguist-language=Kotlin
*.java text eol=lf linguist-language=Java
*.c text eol=lf linguist-language=C
*.h text eol=lf linguist-language=C
*.cpp text eol=lf linguist-language=C++
*.ino text eol=lf linguist-language=C++
# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
# Config
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.properties text eol=lf
# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
# Shell scripts
*.sh text eol=lf
# Binary files (do not normalize)
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.keras filter=lfs diff=lfs merge=lfs -text
*.h5 binary
*.hdf5 binary
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pkl binary
*.tflite filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.apk binary
# Arduino sketches should be treated as C++
*.ino linguist-language=C++
